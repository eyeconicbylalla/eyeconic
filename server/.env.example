PORT=5000
MONGO_URI=
JWT_SECRET=

# Admin credentials (server-side only — never expose to the frontend).
# Required for POST /api/auth/admin/login and all admin endpoints.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Admin session lifetime, e.g. 1h, 8h, 12h (default: 8h)
ADMIN_TOKEN_EXPIRES=8h

# CORS allowlist for browser origins (comma-separated).
# Defaults to the production website when unset; localhost is allowed
# automatically outside production.
ALLOWED_ORIGINS=https://www.eyeconicneetpg.com,https://eyeconicneetpg.com

# Email OTP delivery (required for /api/auth/send-email-otp)
GMAIL_USER=
GMAIL_PASS=

# Cloudinary (required in production for blog image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bm-blog

# Optional rate-limit tuning (defaults shown)
# OTP_SEND_MAX_PER_EMAIL=3
# OTP_SEND_MAX_PER_IP_HOURLY=10
# ADMIN_LOGIN_MAX_ATTEMPTS=5
# LOGIN_MAX_PER_IP=10
# SIGNUP_MAX_PER_IP_HOURLY=5
# OTP_TTL_MINUTES=10

# ---- Eyeconic App integration (student sign-in + quizzes) ----
# The mentorship App API (Render) is the single source of truth for students,
# quizzes, attempts and analytics. The website server proxies it.
# Dev default when APP_API_BASE_URL is unset: http://localhost:3000/api
# Production: APP_API_BASE_URL=https://eyeconic-app-prod-1r8o.onrender.com/api
APP_API_BASE_URL=http://localhost:3000/api

# Shared secret authenticating this server to the App API's
# /api/integration/v1/* endpoints. Must be >= 32 chars and match
# INTEGRATION_SERVICE_TOKEN on the App backend.
APP_INTEGRATION_TOKEN=

# AES key material for the encrypted HttpOnly session cookie (32+ chars,
# unrelated to JWT_SECRET).
SESSION_SECRET=

# Optional tuning (defaults shown)
# APP_API_TIMEOUT_MS=55000
# APP_LOGIN_MAX_PER_IP=10
# APP_HANDOFF_MAX_PER_IP=20
# APP_SESSION_ME_TIMEOUT_MS=10000

# Optional client override (defaults to localhost in dev, production URL otherwise)
# VITE_API_BASE_URL=http://localhost:5000/api
