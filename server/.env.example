PORT=5000
MONGO_URI=
JWT_SECRET=

# Admin credentials (server-side only — never expose to the frontend).
# Required for POST /api/auth/admin/login and all admin endpoints.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Admin session lifetime, e.g. 1h, 8h, 12h (default: 8h)
ADMIN_TOKEN_EXPIRES=8h

# CORS allowlist for browser origins (comma-separated).
# Defaults to the production website when unset; localhost is allowed
# automatically outside production.
ALLOWED_ORIGINS=https://www.eyeconicneetpg.com,https://eyeconicneetpg.com

# Email OTP delivery (required for /api/auth/send-email-otp)
GMAIL_USER=
GMAIL_PASS=

# Cloudinary (required in production for blog image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bm-blog

# Optional rate-limit tuning (defaults shown)
# OTP_SEND_MAX_PER_EMAIL=3
# OTP_SEND_MAX_PER_IP_HOURLY=10
# ADMIN_LOGIN_MAX_ATTEMPTS=5
# LOGIN_MAX_PER_IP=10
# SIGNUP_MAX_PER_IP_HOURLY=5
# OTP_TTL_MINUTES=10

# Optional client override (defaults to localhost in dev, production URL otherwise)
# VITE_API_BASE_URL=http://localhost:5000/api
